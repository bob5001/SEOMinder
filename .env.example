# Copy to .env (gitignored) and fill in. Keeps the repo public-safe.
ANTHROPIC_API_KEY=
PSI_API_KEY=

# Agent-step model providers (see config/models.yaml for routing + which task uses which model).
# OPENAI_API_KEY is only needed if you route a task to the OpenAI provider. Local runtimes
# (Ollama http://localhost:11434, vLLM http://localhost:8000, LM Studio) need NO key.
OPENAI_API_KEY=

# Google Search Console (service account, read-only). Put the JSON at secrets/gsc_sa.json
# (gitignored). Relative paths resolve against the repo root locally and /app in the container,
# so this one value works in both. Use an absolute path only if you keep it elsewhere.
GSC_SERVICE_ACCOUNT_JSON=secrets/gsc_sa.json
GSC_PROPERTY=sc-domain:signalsanctuary.health

# SEO state store — Neon Postgres (source of truth: sites, seo_page_state, seo_weekly, seo_run_log).
# Get the real connection string from the Neon console; it contains a password — keep it out of git.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require

# CodeManager BROKER (agent-knowledge / out-of-band SEO task ledger) — NOT the state store.
# Optional; used by the agent step to log tasks that need a human or a non-content system.
CODEMANAGER_URL=http://192.168.1.189:8007

# WordPress MCP (Signal Sanctuary).
# If the token contains $ ( ) # or spaces, single-quote it so Docker Compose doesn't
# interpolate it, e.g.  WP_MCP_TOKEN='ab)#$c(d'
WP_MCP_URL=https://signalsanctuary.health/wp-json/mcp/v1/http
WP_MCP_TOKEN=

# Discord (webhook, one-way notify — not a bot).
# Single-site: set DISCORD_WEBHOOK_URL (the global fallback).
# Multi-site: give each site its own channel + webhook via a per-site var, either the
# convention DISCORD_WEBHOOK_URL_<SLUG> or a name pointed at by reporting.discord_webhook_env
# in config/<site>.yaml. Resolution order: named -> convention -> global.
DISCORD_WEBHOOK_URL=
# DISCORD_WEBHOOK_URL_SIGNALSANCTUARY=

# Which site config to load from config/
SITE_CONFIG=config/signalsanctuary.yaml
